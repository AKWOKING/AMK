diff --git a/.github/workflows/machine.yml b/.github/workflows/machine.yml
index f06cc03..a5c0e28 100644
--- a/.github/workflows/machine.yml
+++ b/.github/workflows/machine.yml
@@ -8,10 +8,18 @@
 name: La machine
 
 on:
+  # Une seule exécution par commit. Avant, `push:` et `pull_request:` jouaient le MÊME commit
+  # deux fois (mesuré le 24/10 : 12 commits sur 25) — la moitié des minutes pour rien.
   push:
+    branches: [main]
   pull_request:
   workflow_dispatch: {}
 
+# Deux poussées rapprochées : la première n'est plus la vérité, on l'annule.
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
 permissions:
   contents: read
 
@@ -21,11 +29,19 @@ jobs:
     steps:
       - uses: actions/checkout@v4
         with:
-          fetch-depth: 0          # la jauge de fusion a besoin de merge-base avec origin/main
+          # Historique complet pour merge-base, mais SANS les blobs : ils sont récupérés
+          # à la demande. Mesuré : 691 commits = 1,3 Mo de métadonnées ; l'arbre de HEAD = 250 Mo ;
+          # le dépôt entier = 848 Mo. On ne télécharge plus les images mortes de l'historique.
+          fetch-depth: 0
+          filter: blob:none
 
       - uses: actions/setup-python@v5
         with:
           python-version: "3.12"
+          cache: pip
+          # La seule dépendance installée par la CI : graphifyy, épinglé dans install.sh.
+          # La clé du cache suit donc ce fichier — changer l'épinglage refait le cache.
+          cache-dependency-path: tools/graphify/install.sh
 
       - name: Les portes vérifiables dans un runner (secrets, chemins cités)
         run: python3 tools/ops/machine.py --ci
